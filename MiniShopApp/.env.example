# API Backend Base URL (Default points to Railway production API)
EXPO_PUBLIC_API_BASE_URL=https://minishop-production-0016.up.railway.app/api

# Google OAuth Client IDs (Obtain from Google Cloud Console -> Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Facebook OAuth App ID (Obtain from https://developers.facebook.com -> My Apps)
EXPO_PUBLIC_FACEBOOK_APP_ID=
